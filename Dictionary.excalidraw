      "text": "拿着索引去buckets中取对应位置的数据 x，x = 0 代表无数据，x > 0 时，x - 1 是\nentries 的索引",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
