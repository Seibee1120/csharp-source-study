      "isDeleted": true,
      "boundElements": null,
      "updated": 1792917095320,
      "created": 1792912554197,
      "link": null,
      "locked": false,
      "text": "若 next = -1，代表已经查询到底，字典中没有存储。\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "若 next = -1，代表已经查询到底，字典中没有存储。\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
